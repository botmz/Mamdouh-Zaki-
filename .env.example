# ==============================================================================
# MZ Telegram Automation — ناقل قنوات تيليجرام الذكي
# ملف المتغيرات البيئية الإرشادي (.env.example)
# انسخ هذا الملف إلى .env وقم بتعبئة القيم الحقيقية الخاصة بك
# ==============================================================================

# منفذ تشغيل الخادم
PORT=3000

# مفتاح التشفير لجلسات تسجيل دخول المشرف (سلسلة عشوائية آمنة)
JWT_SECRET=replace_with_a_secure_random_string_min_32_characters

# بيانات تيليجرام بوت (Telegram Bot API)
# يتم الحصول عليه من خلال التحدث مع @BotFather على تيليجرام
# مثال: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=

# بيانات حساب تيليجرام الشخصي (Telegram Client API / Telethon)
# مخصصة للقراءة من القنوات الخاصة التي لا يملك البوت صلاحية الانضمام إليها
# يتم استخراجها من https://my.telegram.org (قسم API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# الجلسة النصية (StringSession) للتشغيل المستمر على السيرفر بدون طلب كود في كل مرة
TELEGRAM_SESSION_STRING=

# مسار قاعدة البيانات المحلية SQLite
DATABASE_PATH=./data/mz_automation.db

# إعدادات واجهات أسعار الذهب والبيتكوين
# يوفر النظام مصادر مجانية مباشرة (Binance API للبيتكوين و Metal/Public API للذهب)
# يمكنك اختياريًا إضافة مفتاح واجهة خاصة للذهب مثل metals.dev أو goldapi.io
GOLD_API_KEY=
GOLD_API_SOURCE=free_public # الخيارات: free_public, metals_dev, goldapi_io
BITCOIN_API_SOURCE=binance   # الخيارات: binance, coingecko

# التحديث التلقائي للأسعار بالثواني (افتراضي 300 ثانية = 5 دقائق)
PRICES_UPDATE_INTERVAL_SECONDS=300
